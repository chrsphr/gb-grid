{
  "title": "BMU dispatch",
  "uid": "bmu-dispatch",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Station",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "gbgrid" },
        "query": "SELECT DISTINCT b.station FROM bmu b JOIN bmu_dispatch d ON d.bmu = b.ngc_bm_unit ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "geomap",
      "title": "Stations — click to select",
      "datasource": { "type": "postgres", "uid": "gbgrid" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT station, AVG(latitude) AS latitude, AVG(longitude) AS longitude, MODE() WITHIN GROUP (ORDER BY COALESCE(bmrs_fuel_type, 'UNKNOWN')) AS fuel_type, COUNT(*) AS bmus FROM bmu WHERE latitude IS NOT NULL AND longitude IS NOT NULL GROUP BY station"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "links": [
            {
              "title": "Select ${__data.fields.station}",
              "url": "/d/bmu-dispatch?var-station=${__data.fields.station}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fuel_type" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "WIND":    { "color": "#99dd55", "index": 0,  "text": "WIND" },
                      "CCGT":    { "color": "#ee9944", "index": 1,  "text": "CCGT" },
                      "OCGT":    { "color": "#ee9944", "index": 2,  "text": "OCGT" },
                      "NUCLEAR": { "color": "#0099cc", "index": 3,  "text": "NUCLEAR" },
                      "BIOMASS": { "color": "#aa3355", "index": 4,  "text": "BIOMASS" },
                      "COAL":    { "color": "#aa3355", "index": 5,  "text": "COAL" },
                      "NPSHYD":  { "color": "#22ccbb", "index": 6,  "text": "NPSHYD" },
                      "PS":      { "color": "#00b0bd", "index": 7,  "text": "PS" },
                      "INTFR":   { "color": "#aaaaaa", "index": 8,  "text": "INTFR" },
                      "INTBN":   { "color": "#aaaaaa", "index": 9,  "text": "INTBN" },
                      "INTNEM":  { "color": "#aaaaaa", "index": 10, "text": "INTNEM" },
                      "INTEW":   { "color": "#aaaaaa", "index": 11, "text": "INTEW" },
                      "INTIRL":  { "color": "#aaaaaa", "index": 12, "text": "INTIRL" },
                      "INTGRNL": { "color": "#aaaaaa", "index": 13, "text": "INTGRNL" },
                      "OTHER":   { "color": "#9400FF", "index": 14, "text": "OTHER" },
                      "UNKNOWN": { "color": "#cccccc", "index": 15, "text": "UNKNOWN" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "view": { "id": "coords", "lat": 54.5, "lon": -3, "zoom": 5 },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": { "type": "default", "name": "Layer 0", "config": {} },
        "layers": [
          {
            "type": "markers",
            "name": "Stations",
            "config": {
              "style": {
                "size": { "fixed": 7 },
                "color": { "field": "fuel_type" },
                "opacity": 0.85,
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/circle.svg" },
                "textConfig": { "fontSize": 12, "textAlign": "center", "textBaseline": "middle" }
              },
              "showLegend": true
            },
            "location": { "mode": "coords", "latitude": "latitude", "longitude": "longitude" },
            "tooltip": true
          }
        ],
        "tooltip": { "mode": "details" }
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "$station — station total (PN, dispatched, MEL, B1610)",
      "datasource": { "type": "postgres", "uid": "gbgrid" },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "MW",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "MEL" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Dispatched" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "B1610 actual" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "black" } },
              { "id": "custom.lineWidth", "value": 2.5 },
              { "id": "custom.lineInterpolation", "value": "stepAfter" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT bucket_ts AS time, SUM(pn_mw) AS \"PN\", SUM(boa_level_mw) AS \"Dispatched\", SUM(mel_mw) AS \"MEL\" FROM dispatch_series('$station', $__timeFrom(), $__timeTo(), ('$__interval')::interval) GROUP BY bucket_ts ORDER BY bucket_ts"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT bucket_ts AS time, b1610_mw AS \"B1610 actual\" FROM b1610_series('$station', $__timeFrom(), $__timeTo(), ('$__interval')::interval) ORDER BY bucket_ts"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "$station — dispatched per BMU",
      "datasource": { "type": "postgres", "uid": "gbgrid" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "MW",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 50,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT bucket_ts AS time, bmu AS metric, boa_level_mw AS value FROM dispatch_series('$station', $__timeFrom(), $__timeTo(), ('$__interval')::interval) ORDER BY bucket_ts, bmu"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "$station — SO turn-up (+) and BOA curtailment (−)",
      "datasource": { "type": "postgres", "uid": "gbgrid" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "MW",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SO turn-up" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "BOA curtailment" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "SO curtailment" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT bucket_ts AS time, SUM(so_turnup_mw) AS \"SO turn-up\", -SUM(boa_curtailment_mw) AS \"BOA curtailment\", -SUM(so_curtailment_mw) AS \"SO curtailment\" FROM dispatch_series('$station', $__timeFrom(), $__timeTo(), ('$__interval')::interval) GROUP BY bucket_ts ORDER BY bucket_ts"
        }
      ]
    }
  ]
}
